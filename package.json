{
  "name": "gensane",
  "version": "0.0.0",
  "private": true,
  "description": "A zero-dependency static site generator for developer blogs and portfolios.",
  "license": "MIT",
  "bin": {
    "gensane": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "themes"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example": "pnpm build && cd example && node ../dist/cli/main.js dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.theme.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "html-validate": "11.21.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.5.1"
}
