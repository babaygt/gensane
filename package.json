{
  "name": "@gensane/cli",
  "version": "0.1.0",
  "description": "A zero-dependency static site generator for developer blogs and portfolios.",
  "keywords": [
    "blog",
    "markdown",
    "portfolio",
    "ssg",
    "static-site-generator",
    "zero-dependency"
  ],
  "homepage": "https://gensane.dev",
  "bugs": {
    "url": "https://github.com/babaygt/gensane/issues"
  },
  "license": "MIT",
  "author": "Yigit Baba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babaygt/gensane.git"
  },
  "bin": {
    "gensane": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "skills",
    "themes"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example": "pnpm build && cd example && node ../dist/cli/main.js dev",
    "website": "pnpm build && node scripts/website.ts",
    "screenshots": "node scripts/screenshots.ts",
    "skill": "node scripts/skill.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.theme.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "html-validate": "11.21.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.5.1"
}
